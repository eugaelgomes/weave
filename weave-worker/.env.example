# Environment
NODE_ENV=development

# Database (Required)
DATABASE_HOST_URL=localhost
DATABASE_SERVICE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=weave_notes

# Email Service (Optional - Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Weave Notes <noreply@weavenotes.app>
CONTACT_EMAIL=us@weavenotes.app

# Digital Ocean Spaces / S3 Storage (Optional)
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=your_access_key
DO_SPACES_SECRET_KEY=your_secret_key
DO_SPACES_BUCKET_NAME=wn-storage
DO_SPACES_REGION=sfo3
