# Database Configuration
DATABASE_NAME=
DATABASE_HOST_URL=
DATABASE_SERVICE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# If necessary
SSL_CERTIFICATE=

# Session Configuration
SESSION_SECRET=
SECRET_KEY=
SECRET_KEY_VARIABLE=

# Email Configuration
RESEND_API_KEY=
EMAIL_FROM=Weave <hello@gaelgomes.dev>
# Optional; defaults to FRONTEND_URL/weave-notes-nobg.png
# EMAIL_LOGO_URL=
CONTACT_EMAIL=contact@gaelgomes.dev
SUPPORT_EMAIL=support@gaelgomes.dev

# Node Environment Configuration
NODE_ENV=

# CORS Configuration
# Separar múltiplas origens por vírgula
# Exemplos de configurações:
# - Domínios específicos: https://app.exemplo.com,https://admin.exemplo.com
# - Ambiente de desenvolvimento: http://localhost:3000,http://localhost:3001
# - Subdomínios (usando wildcard): https://*.exemplo.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,https://*.seu-dominio.com

# Desafio para rotas internas (/api/v1/*): JWT curto amarrado ao Origin do front.
# Obrigatório em produção. Gere com: openssl rand -base64 48
INTERNAL_WEB_CHALLENGE_SECRET=

# Cookie Configuration
# COOKIE_DOMAIN: Define o domínio para cookies compartilhados (use .seu-dominio.com para subdomínios)
COOKIE_DOMAIN=

# COOKIE_SAME_SITE: Política de cookies cross-site
# - lax (padrão): Funciona para mesmo domínio e subdomínios. Mais seguro.
# - none: Necessário apenas para domínios completamente diferentes. Requer HTTPS.
# COOKIE_SAME_SITE=lax

# Token IP INFO Configuration
TOKEN_IP=

# Digital Ocean Spaces Configuration
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=your_access_key_here
DO_SPACES_SECRET_KEY=your_secret_key_here
DO_SPACES_BUCKET_NAME=your_bucket_name_here
DO_SPACES_REGION=nyc3

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/sso/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/v1/webhooks/google/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Application Configuration
APP_DOMAIN=weavenotes.app
BCRYPT_SALT_ROUNDS=12

# Github OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/sso/github/callback

# Slack integration (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Required for Events API / interactivity URL verification (POST /webhooks/slack/events)
SLACK_SIGNING_SECRET=
# Optional override; defaults to http://localhost:8080/api/v1/webhooks/slack/oauth/callback (dev)
# SLACK_REDIRECT_URI=http://localhost:8080/api/v1/webhooks/slack/oauth/callback
# Optional comma-separated bot scopes override (see src/services/slack/slack.client.js)
# SLACK_BOT_SCOPES=chat:write,chat:write.public,channels:read,groups:read,im:read,mpim:read