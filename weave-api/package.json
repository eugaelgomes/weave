{
  "name": "weave-notes-api",
  "version": "1.2.0",
  "description": "",
  "main": "src/index.js",
  "_moduleAliases": {
    "@": "src"
  },
  "scripts": {
    "test": "node --test src/**/*.test.js",
    "start": "node dist/index.js --ignore-scripts",
    "dev": "nodemon --exec ts-node src/index.js --ignore-scripts",
    "dev:doppler": "doppler run --project weave-api --config dev -- npm run dev --ignore-scripts",
    "start:doppler": "doppler run --project weave-api --config dev -- npm start --ignore-scripts",
    "build": "babel src -d dist --extensions \".ts,.tsx,.js,.jsx\"",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts}\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "audit:errors": "bash scripts/audit-api-errors.sh",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "cd .. && husky .husky",
    "release": "commit-and-tag-version"
  },
  "keywords": [
    "express",
    "router",
    "api",
    "weave-notes",
    "backend",
    "typescript",
    "weave-notes-api"
  ],
  "author": {
    "name": "Gael Renê Gomes",
    "email": "hello@gaelgomes.dev",
    "url": "https://gaelgomes.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugaelgomes/weave-notes.git"
  },
  "license": "ISC",
  "overrides": {
    "fast-xml-parser": ">=5.3.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.892.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "axios": "^1.7.8",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^9.14.1",
    "googleapis": "^171.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "request-ip": "^3.3.0",
    "resend": "^6.1.3",
    "sharp": "^0.33.0",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/request-ip": "^0.0.41",
    "babel-plugin-module-resolver": "^5.0.2",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.9.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.2.0"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,cjs,ts}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  }
}
