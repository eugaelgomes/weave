model spans {
  id                String           @id @db.Uuid
  trace_id          String           @db.Uuid
  parent_span_id    String?          @db.Uuid
  workspace_id      String           @db.Uuid
  name              String           @db.VarChar(255)
  span_type         String           @db.VarChar(50)
  start_time        DateTime         @db.Timestamptz(6)
  end_time          DateTime?        @db.Timestamptz(6)
  status            String?          @default("running") @db.VarChar(50)
  input             Json?            @default("{}")
  output            Json?            @default("{}")
  error_message     String?
  prompt_tokens     Int?             @default(0)
  completion_tokens Int?             @default(0)
  model             String?          @db.VarChar(255)
  metadata          Json?            @default("{}")
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  workspaces        workspaces       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spans             spans?           @relation("spansTospans", fields: [parent_span_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_spans       spans[]          @relation("spansTospans")
  traces            traces           @relation(fields: [trace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_evaluations    ai_evaluations[]

  @@index([workspace_id], map: "idx_spans_workspace_id")
  @@index([parent_span_id], map: "idx_spans_parent_span_id")
  @@index([trace_id], map: "idx_spans_trace_id")
}

model traces {
  id             String           @id @db.Uuid
  workspace_id   String           @db.Uuid
  team_id        String?          @db.Uuid
  user_id        String?          @db.Uuid
  session_id     String?          @db.VarChar(255)
  name           String           @db.VarChar(255)
  start_time     DateTime         @db.Timestamptz(6)
  end_time       DateTime?        @db.Timestamptz(6)
  status         String?          @default("running") @db.VarChar(50)
  total_tokens   Int?             @default(0)
  total_cost     Decimal?         @default(0.000000) @db.Decimal(10, 6)
  metadata       Json?            @default("{}")
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  spans          spans[]
  ai_evaluations ai_evaluations[]
  workspaces     workspaces       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_traces_workspace")
  teams          teams?           @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "fk_traces_team")
  users          users?           @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([created_at], map: "idx_traces_created_at")
  @@index([workspace_id], map: "idx_traces_workspace_id")
}

model ai_evaluations {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trace_id       String   @db.Uuid
  observation_id String?  @db.Uuid
  name           String   @db.VarChar(100)
  score          Float
  comment        String?
  source         String   @default("USER") @db.VarChar(50)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  traces         traces   @relation(fields: [trace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spans          spans?   @relation(fields: [observation_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([trace_id], map: "idx_ai_evaluations_trace")
}

