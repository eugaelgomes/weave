generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================
// CORE / TENANT / USERS
// ============================================================

model credentials {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String?     @db.Uuid
  user_id        String      @db.Uuid
  type           String      @db.VarChar(50)
  name           String      @db.VarChar(255)
  encrypted_data String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  workspaces     workspaces? @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id], map: "idx_credentials_workspace")
  @@index([user_id], map: "idx_credentials_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_token_usage_logs {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_token_id  String      @db.Uuid
  user_id       String      @db.Uuid
  workspace_id  String?     @db.Uuid
  request_id    String?     @db.VarChar(100)
  endpoint      String      @db.VarChar(255)
  http_method   String      @db.VarChar(10)
  status_code   Int         @db.SmallInt
  success       Boolean?
  error_message String?
  latency_ms    Int?
  ip_address    String?     @db.Inet
  metadata      Json?
  deleted       Boolean     @default(false)
  deleted_at    DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  workspaces    workspaces? @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_api_token_usage_logs_workspace")
  api_tokens    api_tokens  @relation(fields: [api_token_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_api_token_usage_logs_token")
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_api_token_usage_logs_user")

  @@index([created_at], map: "idx_api_token_usage_logs_created_at")
  @@index([metadata], map: "idx_api_token_usage_logs_metadata", type: Gin)
  @@index([api_token_id, created_at], map: "idx_api_token_usage_logs_token")
  @@index([user_id, workspace_id, created_at], map: "idx_api_token_usage_logs_user_workspace")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_tokens {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @db.VarChar(255)
  key_prefix              String                    @unique @db.VarChar(50)
  token_hash              String                    @db.VarChar(255)
  user_id                 String                    @db.Uuid
  workspace_id            String?                   @db.Uuid
  scopes                  String[]                  @default(["read"])
  description             String?                   @db.VarChar(255)
  expires_at              DateTime?                 @db.Timestamptz(6)
  revoked_at              DateTime?                 @db.Timestamptz(6)
  budget_usd              Decimal?                  @db.Decimal(10, 4)
  spend_usd               Decimal                   @default(0) @db.Decimal(10, 4)
  max_rpm                 Int?
  max_tpm                 Int?
  allowed_models          String[]                  @default([])
  deleted                 Boolean                   @default(false)
  deleted_at              DateTime?                 @db.Timestamptz(6)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  api_token_usage_logs    api_token_usage_logs[]
  workspaces              workspaces?               @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_tokens_workspace_fk")
  users                   users                     @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "api_tokens_user_fk")
  public_api_request_logs public_api_request_logs[]

  @@index([key_prefix], map: "idx_api_tokens_key_prefix")
  @@index([user_id, workspace_id], map: "idx_api_tokens_user_workspace")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model workspace_settings {
  workspace_id String @id @db.Uuid

  saml         Json @default("{}")
  domains      Json @default("{}")
  tracing      Json @default("{}")
  branding     Json @default("{}")
  preferences  Json @default("{}")
  integrations Json @default("{}")

  deleted    Boolean   @default(false)
  deleted_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model workspace_members {
  id                                        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id                              String                       @db.Uuid
  user_id                                   String                       @db.Uuid
  status                                    workspace_member_status_enum @default(ACTIVE)
  invited_by                                String?                      @db.Uuid
  suspended                                 Boolean                      @default(false)
  deleted                                   Boolean                      @default(false)
  removed_at                                DateTime?                    @db.Timestamptz(6)
  removed_by                                String?                      @db.Uuid
  deleted_at                                DateTime?                    @db.Timestamptz(6)
  created_at                                DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime?                    @db.Timestamptz(6)
  workspaces                                workspaces                   @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workspace_members_workspace")
  users_workspace_members_user_idTousers    users                        @relation("workspace_members_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workspace_members_user")
  users_workspace_members_invited_byTousers users?                       @relation("workspace_members_invited_byTousers", fields: [invited_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_members_invited_by_fk")
  users_workspace_members_removed_byTousers users?                       @relation("workspace_members_removed_byTousers", fields: [removed_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_members_removed_by_fk")
  workspace_member_roles                    workspace_member_roles[]

  @@unique([workspace_id, user_id], map: "unique_workspace_user")
  @@index([workspace_id], map: "idx_workspace_members_workspace_id")
  @@index([user_id], map: "idx_workspace_members_user_id")
}

model workspace_member_roles {
  workspace_member_id String            @db.Uuid
  role_id             String            @db.Uuid
  workspace_members   workspace_members @relation(fields: [workspace_member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wm_roles_member")
  workspace_roles     workspace_roles   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wm_roles_role")

  @@id([workspace_member_id, role_id])
  @@index([workspace_member_id], map: "idx_wm_roles_member")
  @@index([role_id], map: "idx_wm_roles_role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model workspaces {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id            String                 @unique @default(cuid()) @db.VarChar(30)
  user_id              String                 @db.Uuid
  workspace_name       String                 @default("New Workspace") @db.VarChar(80)
  unique_name          String                 @unique @db.VarChar(40)
  logo_url             String?
  banner_url           String?
  description          String?                @default("Type description here...")
  plan_id              String?                @db.Uuid
  deleted              Boolean                @default(false)
  deleted_at           DateTime?              @db.Timestamptz(6)
  deleted_by           String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  status               workspace_status_enum  @default(ACTIVE)
  stripe_customer_id   String?                @db.VarChar(255)
  billing_email        String?                @db.VarChar(255)
  country              String?                @db.VarChar(2)
  public_workspace_id  String
  ai_artifacts         ai_artifacts[]
  ai_messages          ai_messages[]
  ai_sessions          ai_sessions[]
  api_token_usage_logs api_token_usage_logs[]
  api_tokens           api_tokens[]
  ai_prompts           ai_prompts[]
  workflow_comments    workflow_comments[]
  teams                teams[]
  workspace_settings   workspace_settings?
  workspace_roles      workspace_roles[]

  workspace_members                    workspace_members[]
  users_workspaces_user_idTousers      users                     @relation("workspaces_user_idTousers", fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_workspaces_user_id")
  public_api_request_logs              public_api_request_logs[]
  spans                                spans[]
  tags                                 tags[]
  traces                               traces[]
  users_users_workspace_idToworkspaces users[]                   @relation("users_workspace_idToworkspaces")
  ai_mcp_servers                       ai_mcp_servers[]
  workflows                            workflows[]
  credentials                          credentials[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model public_api_request_logs {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_token_id    String?     @db.Uuid
  user_id         String?     @db.Uuid
  workspace_id    String?     @db.Uuid
  http_method     String      @db.VarChar(10)
  path            String
  api_version     String      @default("v1") @db.VarChar(10)
  scopes_required String[]
  status_code     Int         @db.SmallInt
  duration_ms     Int?
  error_code      String?     @db.VarChar(64)
  request_id      String?     @db.Uuid
  ip_address      String?     @db.Inet
  user_agent      String?
  origin_header   String?
  referer_header  String?
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  api_tokens      api_tokens? @relation(fields: [api_token_id], references: [id], onUpdate: NoAction)
  workspaces      workspaces? @relation(fields: [workspace_id], references: [id], onUpdate: NoAction)
  users           users?      @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model sessions {
  sid         String    @id @db.VarChar
  sess        Json      @db.Json
  expire      DateTime  @db.Timestamp(6)
  user_id     String?   @db.Uuid
  ip_address  String?   @db.VarChar(45)
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  last_active DateTime? @default(now()) @db.Timestamp(6)
  api_type    String?   @db.VarChar(20)
  users       users?    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expire], map: "idx_sessions_expire")
  @@index([last_active], map: "idx_sessions_last_active")
  @@index([user_id], map: "idx_sessions_user_id")
}

model workspace_roles {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  name         String    @db.VarChar(100)
  description  String?
  permissions  Json      @default("[]")
  is_system    Boolean   @default(false)
  created_by   String?   @db.Uuid
  deleted      Boolean   @default(false)
  deleted_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  workspaces                              workspaces               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workspace_member_roles                  workspace_member_roles[]
  team_members                            team_members[]
  users_workspace_roles_created_byTousers users?                   @relation("workspace_roles_created_byTousers", fields: [created_by], references: [user_id])
  users_workspace_roles_deleted_byTousers users?                   @relation("workspace_roles_deleted_byTousers", fields: [deleted_by], references: [user_id])

  @@unique([workspace_id, name])
  @@map("workspaces_roles")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tokens {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String          @db.Uuid
  token          String          @db.Text
  type           token_type_enum
  code           String?         @db.VarChar(20)
  data_to_update Json?           @default("{}")
  active         Boolean         @default(true)
  used_at        DateTime?       @db.Timestamptz(6)
  deleted        Boolean         @default(false)
  deleted_at     DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  expires_at     DateTime        @db.Timestamptz(6)
  users          users           @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tokens_user")

  @@index([token], map: "idx_tokens_token")
  @@index([user_id, type, active], map: "idx_tokens_lookup")
  @@index([code, type, active], map: "idx_tokens_code_lookup")
}

model user_logs {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  log_type   user_log_category
  log        Json?
  deleted    Boolean           @default(false)
  deleted_at DateTime?         @db.Timestamptz(6)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "user_logs_user_fk")

  @@index([created_at], map: "idx_user_logs_created_at")
  @@index([user_id], map: "idx_user_logs_user_id")
}

model user_oauth_tokens {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String              @db.Uuid
  provider      oauth_provider_enum @default(GOOGLE)
  access_token  String
  refresh_token String?
  expires_at    DateTime?           @db.Timestamptz(6)
  deleted       Boolean             @default(false)
  deleted_at    DateTime?           @db.Timestamptz(6)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?           @db.Timestamptz(6)
  users         users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_oauth_tokens_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  user_id                                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                        String                   @db.VarChar(255)
  email                                       String                   @unique @db.VarChar(255)
  username                                    String                   @unique @db.VarChar(50)
  password                                    String                   @db.VarChar(255)
  avatar_url                                  String?
  auth_with_google                            Boolean                  @default(false)
  google_id                                   String?                  @unique @db.VarChar(255)
  auth_with_github                            Boolean                  @default(false)
  github_id                                   String?                  @unique @db.VarChar(255)
  theme_mode                                  theme_mode_pattern       @default(DARK)
  phone_number                                String?                  @unique @db.VarChar(20)
  birth_date                                  DateTime?                @db.Date
  private_profile                             Boolean                  @default(false)
  timezone                                    String?                  @db.VarChar(100)
  email_verified                              Boolean                  @default(false)
  email_verified_at                           DateTime?                @db.Timestamptz(6)
  last_login                                  DateTime?                @db.Timestamptz(6)
  workspace_id                                String?                  @db.Uuid
  plan_id                                     String?                  @db.Uuid
  user_preference                             Json                     @default("{}")
  onboarding_state                            Json                     @default("{\"step\": \"REGISTERED\", \"completed_steps\": [], \"metadata\": {}}")
  deleted                                     Boolean                  @default(false)
  deleted_at                                  DateTime?                @db.Timestamptz(6)
  created_at                                  DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime                 @default(now()) @db.Timestamptz(6)
  status                                      user_status_enum         @default(ACTIVE)
  auth_with_microsoft                         Boolean?                 @default(false)
  microsoft_id                                String?
  public_user_id                              String                   @unique(map: "users_public_user_id_idx")
  auth_with_saml                              Boolean?                 @default(false)
  ai_artifacts                                ai_artifacts[]
  ai_messages                                 ai_messages[]
  ai_sessions                                 ai_sessions[]
  ai_user_agent                               ai_user_agent[]
  api_token_usage_logs                        api_token_usage_logs[]
  api_tokens                                  api_tokens[]
  jobs                                        jobs[]
  workflow_collaborators_removed_byTousers    workflow_collaborators[] @relation("note_collaborators_removed_byTousers")
  workflow_collaborators_user_idTousers       workflow_collaborators[] @relation("note_collaborators_user_idTousers")
  ai_prompts                                  ai_prompts[]
  workflow_comments                           workflow_comments[]
  notifications_notifications_actor_idTousers notifications[]          @relation("notifications_actor_idTousers")
  notifications_notifications_user_idTousers  notifications[]          @relation("notifications_user_idTousers")
  teams_teams_created_byTousers               teams[]                  @relation("teams_created_byTousers")
  teams_teams_deleted_byTousers               teams[]                  @relation("teams_deleted_byTousers")
  teams_teams_updated_byTousers               teams[]                  @relation("teams_updated_byTousers")

  workspace_members_workspace_members_user_idTousers    workspace_members[]       @relation("workspace_members_user_idTousers")
  workspace_members_workspace_members_invited_byTousers workspace_members[]       @relation("workspace_members_invited_byTousers")
  workspace_members_workspace_members_removed_byTousers workspace_members[]       @relation("workspace_members_removed_byTousers")
  workspaces_workspaces_user_idTousers                  workspaces[]              @relation("workspaces_user_idTousers")
  team_members_added_byTousers                          team_members[]            @relation("team_members_added_byTousers")
  team_members_user_idTousers                           team_members[]            @relation("team_members_user_idTousers")
  workspace_roles_created_byTousers                     workspace_roles[]         @relation("workspace_roles_created_byTousers")
  workspace_roles_deleted_byTousers                     workspace_roles[]         @relation("workspace_roles_deleted_byTousers")
  public_api_request_logs                               public_api_request_logs[]
  sessions                                              sessions[]
  tags                                                  tags[]
  tokens                                                tokens[]
  traces                                                traces[]
  user_logs                                             user_logs[]
  user_oauth_tokens                                     user_oauth_tokens[]
  workspaces_users_workspace_idToworkspaces             workspaces?               @relation("users_workspace_idToworkspaces", fields: [workspace_id], references: [id], onUpdate: NoAction)
  workflows                                             workflows[]
  credentials                                           credentials[]

  @@index([deleted], map: "idx_users_deleted")
  @@index([workspace_id], map: "idx_users_workspace_id")
  @@index([plan_id], map: "idx_users_plan_id")
}

// ============================================================
// HIERARCHY / TEAMS
// ============================================================

model teams {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id      String                    @unique @default(cuid()) @db.VarChar(30)
  workspace_id   String                    @db.Uuid
  parent_team_id String?                   @db.Uuid
  name           String                    @db.VarChar(100)
  slug           String
  description    String?
  icon           Json?                     @default("{}")
  color          String?                   @db.VarChar(7)
  visibility     workspace_visibility_enum @default(PRIVATE)
  properties     Json                      @default("{}")
  active         Boolean                   @default(true)
  deleted        Boolean                   @default(false)
  deleted_at     DateTime?                 @db.Timestamptz(6)
  created_by     String                    @db.Uuid
  updated_by     String?                   @db.Uuid
  deleted_by     String?                   @db.Uuid
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                  @default(now()) @db.Timestamptz(6)

  // Hierarchy
  workspaces  workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_teams_workspace")
  parent_team teams?     @relation("teamsToTeams", fields: [parent_team_id], references: [id], onUpdate: NoAction, map: "fk_teams_parent")
  sub_teams   teams[]    @relation("teamsToTeams")

  // Members
  team_members team_members[]

  // AI Ecosystem
  agents      ai_user_agent[]
  ai_sessions ai_sessions[]
  ai_prompts  ai_prompts[]
  traces      traces[]
  tags        tags[]

  // Audit
  users_teams_created_byTousers users  @relation("teams_created_byTousers", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "teams_created_by_fk")
  users_teams_deleted_byTousers users? @relation("teams_deleted_byTousers", fields: [deleted_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction, map: "teams_deleted_by_fk")
  users_teams_updated_byTousers users? @relation("teams_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction, map: "teams_updated_by_fk")

  @@unique([workspace_id, slug], map: "uq_teams_workspace_slug")
  @@index([workspace_id], map: "idx_teams_workspace")
  @@index([parent_team_id], map: "idx_teams_parent")
}

model team_members {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id    String    @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  added_by   String?   @db.Uuid
  suspended  Boolean   @default(false)
  deleted    Boolean   @default(false)
  deleted_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  teams                              teams           @relation(fields: [team_id], references: [id], onDelete: Cascade)
