  projects                            projects                              @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reasoning_project")
  project_ai_report_configs           project_ai_report_configs?            @relation(fields: [report_config_id], references: [id], onUpdate: NoAction, map: "fk_reasoning_report_config")
  project_sprints                     project_sprints                       @relation(fields: [sprint_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reasoning_sprint")
  users                               users                                 @relation(fields: [triggered_by], references: [user_id], onUpdate: NoAction, map: "fk_reasoning_triggered_by")
}

model organization_tracing_settings {
  organization_id String        @id @db.Uuid
  enabled         Boolean       @default(false)
  retention_days  Int?
  export_target   String?       @default("local") @db.VarChar(50)
  otlp_endpoint   String?       @db.VarChar(255)
  otlp_headers    Json?         @default("{}")
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model spans {
  id                String        @id @db.Uuid
  trace_id          String        @db.Uuid
  parent_span_id    String?       @db.Uuid
  organization_id   String        @db.Uuid
  name              String        @db.VarChar(255)
  span_type         String        @db.VarChar(50)
  start_time        DateTime      @db.Timestamptz(6)
  end_time          DateTime?     @db.Timestamptz(6)
  status            String?       @default("running") @db.VarChar(50)
  input             Json?         @default("{}")
  output            Json?         @default("{}")
  error_message     String?
  prompt_tokens     Int?          @default(0)
  completion_tokens Int?          @default(0)
  model             String?       @db.VarChar(255)
  metadata          Json?         @default("{}")
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spans             spans?        @relation("spansTospans", fields: [parent_span_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_spans       spans[]       @relation("spansTospans")
  traces            traces        @relation(fields: [trace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_spans_organization_id")
  @@index([parent_span_id], map: "idx_spans_parent_span_id")
  @@index([trace_id], map: "idx_spans_trace_id")
}

model traces {
  id              String        @id @db.Uuid
  organization_id String        @db.Uuid
  user_id         String?       @db.Uuid
  project_id      String?       @db.Uuid
  session_id      String?       @db.VarChar(255)
  name            String        @db.VarChar(255)
  start_time      DateTime      @db.Timestamptz(6)
  end_time        DateTime?     @db.Timestamptz(6)
  status          String?       @default("running") @db.VarChar(50)
  total_tokens    Int?          @default(0)
  total_cost      Decimal?      @default(0.000000) @db.Decimal(10, 6)
  metadata        Json?         @default("{}")
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  spans           spans[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects        projects?     @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  users           users?        @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([created_at], map: "idx_traces_created_at")
  @@index([organization_id], map: "idx_traces_organization_id")
}

