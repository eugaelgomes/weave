generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model ai_agent_runs {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id          String             @db.Uuid
  trigger_id        String?            @db.Uuid
  status            String             @db.VarChar(50)
  logs              Json?              @default("[]")
  started_at        DateTime?          @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?          @db.Timestamptz(6)
  error_message     String?
  ai_user_agent     ai_user_agent      @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_agent_triggers ai_agent_triggers? @relation(fields: [trigger_id], references: [id], onUpdate: NoAction)
}

model ai_agent_triggers {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id      String          @db.Uuid
  trigger_type  String          @db.VarChar(50)
  config        Json            @default("{}")
  is_active     Boolean?        @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  ai_agent_runs ai_agent_runs[]
  ai_user_agent ai_user_agent   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ai_artifacts {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String?           @db.Uuid
  user_id          String            @db.Uuid
  session_id       String?           @db.Uuid
  title            String            @default("Untitled Document") @db.VarChar(255)
  type             String            @default("document") @db.VarChar(50)
  content          Json              @default("[]")
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  organizations    organizations?    @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_chat_sessions ai_chat_sessions? @relation(fields: [session_id], references: [id], onUpdate: NoAction)
  users            users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_ai_artifacts_organization_id")
  @@index([user_id], map: "idx_ai_artifacts_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_chat_messages {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id            String           @db.Uuid
  user_id               String           @db.Uuid
  role                  String           @db.VarChar(20)
  content               String?
  model                 String?          @db.VarChar(50)
  metadata              Json             @default("{}")
  created_at            DateTime         @default(now()) @db.Timestamptz(6)
  request_id            String?          @db.Uuid
  provider              String?          @db.VarChar(40)
  status                String           @default("ok") @db.VarChar(20)
  error_code            String?          @db.VarChar(80)
  error_message         String?
  latency_ms            Int?
  input_tokens          Int?
  output_tokens         Int?
  total_tokens          Int?
  agent_id              String?          @db.Uuid
  allow_edit            Boolean?         @default(false)
  parent_message_id     String?          @db.Uuid
  tool_calls            Json?
  tool_call_id          String?          @db.VarChar(255)
  deleted               Boolean          @default(false)
  deleted_at            DateTime?        @db.Timestamptz(6)
  organization_id       String?          @db.Uuid
  user_feedback_rating  String?          @db.VarChar(50)
  user_feedback_comment String?
  ai_user_agent         ai_user_agent?   @relation(fields: [agent_id], references: [id], onUpdate: NoAction, map: "ai_chat_messages_agent_fk")
  organizations         organizations?   @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "ai_chat_messages_organization_FK")
  ai_chat_sessions      ai_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_chat_messages_session_fk")
  users                 users            @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "ai_chat_messages_user_fk")

  @@index([provider, created_at(sort: Desc)], map: "idx_ai_chat_messages_provider_created")
  @@index([request_id], map: "idx_ai_chat_messages_request_id")
  @@index([session_id, status, created_at(sort: Desc)], map: "idx_ai_chat_messages_session_status_created")
  @@index([status, created_at(sort: Desc)], map: "idx_ai_chat_messages_status_created")
  @@index([session_id, created_at], map: "ix_ai_chat_messages_session_created_at")
  @@index([user_id, created_at], map: "ix_ai_chat_messages_user_created_at")
}

model ai_chat_sessions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String             @db.Uuid
  title            String             @default("Nova Conversa") @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  last_message_at  DateTime?          @db.Timestamptz(6)
  last_model       String?            @db.VarChar(80)
  last_provider    String?            @db.VarChar(40)
  message_count    Int                @default(0)
  total_tokens     BigInt             @default(0)
  archived         Boolean            @default(false)
  deleted          Boolean            @default(false)
  deleted_at       DateTime?          @db.Timestamptz(6)
  organization_id  String?            @db.Uuid
  project_id       String?            @db.Uuid
  note_id          String?            @db.Uuid
  context          Json               @default("{}")
  share_token      String?            @unique @db.VarChar(255)
  ai_artifacts     ai_artifacts[]
  ai_chat_messages ai_chat_messages[]
  organizations    organizations?     @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "ai_chat_sessions_org_fk")
  projects         projects?          @relation(fields: [project_id], references: [id], onUpdate: NoAction, map: "ai_chat_sessions_project_fk")
  users            users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "ai_chat_sessions_user_fk")

  @@index([user_id, archived, updated_at(sort: Desc)], map: "idx_ai_chat_sessions_user_archived_updated")
}

model ai_custom_tools {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  organization_id String?   @db.Uuid
  name            String    @db.VarChar(100)
  description     String?
  webhook_url     String
