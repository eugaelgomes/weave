  deleted         Boolean?  @default(false)
  deleted_at      DateTime? @db.Timestamptz(6)
}

model ai_llm_models {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier           String    @unique @db.VarChar(100)
