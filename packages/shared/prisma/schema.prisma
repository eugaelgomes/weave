  plan_id                  String    @db.Uuid
  status                   String
  provider                 String    @default("internal") @db.VarChar(30)
  provider_customer_id     String?
  provider_subscription_id String?
  current_period_start     DateTime  @db.Timestamptz(6)
  current_period_end       DateTime  @db.Timestamptz(6)
  cancel_at_period_end     Boolean   @default(false)
  canceled_at              DateTime? @db.Timestamptz(6)
  trial_start              DateTime? @db.Timestamptz(6)
  trial_end                DateTime? @db.Timestamptz(6)
  metadata                 Json      @default("{}")
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  plans                    plans     @relation(fields: [plan_id], references: [plan_id], onUpdate: NoAction)

  @@unique([subscriber_type, subscriber_id], map: "uq_subscriptions_subscriber")
  @@index([subscriber_type, subscriber_id, status, updated_at(sort: Desc)], map: "idx_subscriptions_lookup")
}

model usage_events {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String      @unique @db.Uuid
  plan_usage_id String      @db.Uuid
  operation     String
  payload       Json        @default("{}")
  processed_at  DateTime    @default(now()) @db.Timestamptz(6)
  plan_usages   plan_usages @relation(fields: [plan_usage_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plan_usage_id, processed_at(sort: Desc)], map: "idx_usage_events_usage_id")
}

