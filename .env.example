# ==============================================================================
# The Weave - Unified Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in the values according to your environment.
# Both server and worker services will load from this unified configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Environment (Server & Worker)
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_DOMAIN=your-app-domain.com
# Domain used by Caddy to serve the API (e.g. apis.weavenotes.app)
API_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://app.your-domain.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# Cookie Configuration
# COOKIE_DOMAIN: Define domain for shared cookies (use .your-domain.com for subdomains)
COOKIE_DOMAIN=
# COOKIE_SAME_SITE: lax (default) or none (requires HTTPS)
# COOKIE_SAME_SITE=lax

# Internal Web Challenge Secret
# Challenge for internal routes (/api/v1/*): short JWT tied to frontend Origin.
# Required in production. Generate with: openssl rand -base64 48
INTERNAL_WEB_CHALLENGE_SECRET=

# ------------------------------------------------------------------------------
# Frontend (Next.js - Web)
# ------------------------------------------------------------------------------
# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BLOG_URL=https://blog.your-domain.com

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Frontend Feature Flags & Toggles
NEXT_PUBLIC_ENABLE_NOTES_BLOCKS_AUTOSAVE_V2=true
NEXT_PUBLIC_USE_TIPTAP_EDITOR=true

# External Integrations (Frontend)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST_URL=localhost
DATABASE_SERVICE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=weave_notes
# SSL_CERTIFICATE=

# ------------------------------------------------------------------------------
# Cache & Queues (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Queue Keys Overrides (Optional)
# REDIS_ENGINE_LLM_REQUEST_QUEUE_KEY=queue:engine:llm:request
# REDIS_ENGINE_LLM_RESPONSE_PREFIX=queue:engine:llm:response:
# REDIS_EMAIL_QUEUE_KEY=queue:email
# REDIS_ENGINE_LLM_DEAD_LETTER_QUEUE_KEY=weave:engine:llm:dead-letter

# ------------------------------------------------------------------------------
# Authentication & Sessions
# ------------------------------------------------------------------------------
SESSION_SECRET=your_session_secret
SECRET_KEY=your_secret_key
SECRET_KEY_VARIABLE=your_secret_key_variable
BCRYPT_SALT_ROUNDS=12
TOKEN_IP=

# ------------------------------------------------------------------------------
# Storage (S3 / Digital Ocean Spaces)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_REGION=nyc3

# ------------------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------------------
# (Example generic SMTP configuration - requires adapting codebase if using Nodemailer instead of Resend)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=465
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
EMAIL_FROM=Your App Name <hello@your-domain.com>
CONTACT_EMAIL=contact@your-domain.com
SUPPORT_EMAIL=support@your-domain.com
# Optional; defaults to FRONTEND_URL/weave-notes-nobg.png
# EMAIL_LOGO_URL=

# ------------------------------------------------------------------------------
# AI & LLM Engine (Worker / LLM)
# ------------------------------------------------------------------------------
# Internal Weave API URL for MCP client
WEAVE_API_URL=http://localhost:8080

# Primary Model API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Azure / Foundry overrides (Optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# FOUNDRY_API_KEY=
# FOUNDRY_PROJECT_URL=

# Engine Configurations (Optional overrides)
# ENGINE_MAX_CONCURRENT_JOBS=5
# WEAVE_ENGINE_JOB_MAX_RETRIES=4
# WEAVE_ENGINE_MAX_REACT_ITERATIONS=4
# WEAVE_ENGINE_CHAT_TASK_TIMEOUT_MS=65000
# WEAVE_CHAT_CONTEXT_MAX_MESSAGES=20
# WEAVE_CHAT_CONTEXT_MAX_MESSAGE_CHARS=35000
# WEAVE_CHAT_CONTEXT_MAX_TOTAL_CHARS=150000
# WEAVE_MAX_INLINE_FILES_PER_REQUEST=3

# ------------------------------------------------------------------------------
# Telemetry & Monitoring
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# OAuth Integrations
# ------------------------------------------------------------------------------

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/sso/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/v1/webhooks/google/callback

# Github OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/sso/github/callback

# Microsoft OAuth / Entra ID
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=common

# Slack Integration (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Required for Events API / interactivity URL verification
SLACK_SIGNING_SECRET=
# Optional overrides
# SLACK_REDIRECT_URI=http://localhost:8080/api/v1/webhooks/slack/oauth/callback
# SLACK_BOT_SCOPES=chat:write,chat:write.public,channels:read,groups:read,im:read,mpim:read

# ------------------------------------------------------------------------------
# Remote Deployment (for scripts/deploy.sh)
# ------------------------------------------------------------------------------
# REMOTE_HOST=your-vps-ip
# REMOTE_USER=root
# APP_DIR=/root/theweave
# DOPPLER_TOKEN=dp.st...
