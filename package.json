{
  "name": "theweave-workspace",
  "private": true,
  "author": {
    "name": "Gael R. Gomes",
    "email": "gael.rens@gmail.com",
    "url": "https://gaelgomes.dev"
  },
  "packageManager": "npm@11.18.0",
  "bin": {
    "theweave-workspace": "./bin/create-weave.js",
    "theweave": "./bin/create-weave.js",
    "create-weave": "./bin/create-weave.js",
    "weave": "./bin/create-weave.js"
  },
  "scripts": {
    "create-weave": "node ./bin/create-weave.js",
    "deploy": "./scripts/deploy.sh",
    "deploy:engine": "./scripts/deploy.sh engine",
    "deploy:server": "./scripts/deploy.sh server",
    "deploy:worker": "./scripts/deploy.sh worker",
    "clean:ports": "./scripts/clean-ports.sh",
    "dev": "./scripts/run-dev.sh",
    "dev:doppler": "USE_DOPPLER=true ./scripts/run-dev.sh",
    "dev:local": "USE_DOPPLER=false ./scripts/run-dev.sh",
    "dev:clean": "./scripts/clean-ports.sh && npm run dev",
    "dev:clean:doppler": "./scripts/clean-ports.sh && npm run dev:doppler",
    "dev:clean:local": "./scripts/clean-ports.sh && npm run dev:local",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose stop redis",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "check": "turbo check",
    "db:migrate": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate dev --schema=packages/shared/prisma/schema.prisma'",
    "db:migrate:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate dev --schema=packages/shared/prisma/schema.prisma'",
    "db:migrate:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate dev --schema=packages/shared/prisma/schema.prisma'",
    "db:migrate:reset": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate reset --schema=packages/shared/prisma/schema.prisma --force' && npm run db:triggers && npm run db:seed",
    "db:migrate:reset:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate reset --schema=packages/shared/prisma/schema.prisma --force' && npm run db:triggers:doppler && npm run db:seed:doppler",
    "db:migrate:reset:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma migrate reset --schema=packages/shared/prisma/schema.prisma --force' && npm run db:triggers:local && npm run db:seed:local",
    "db:generate": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma generate --schema=packages/shared/prisma/schema.prisma'",
    "db:generate:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma generate --schema=packages/shared/prisma/schema.prisma'",
    "db:generate:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma generate --schema=packages/shared/prisma/schema.prisma'",
    "db:push": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db push --schema=packages/shared/prisma/schema.prisma --accept-data-loss'",
    "db:push:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db push --schema=packages/shared/prisma/schema.prisma --accept-data-loss'",
    "db:push:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db push --schema=packages/shared/prisma/schema.prisma --accept-data-loss'",
    "db:triggers": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db execute --file packages/shared/prisma/setup_triggers.sql --schema packages/shared/prisma/schema.prisma'",
    "db:triggers:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db execute --file packages/shared/prisma/setup_triggers.sql --schema packages/shared/prisma/schema.prisma'",
    "db:triggers:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db execute --file packages/shared/prisma/setup_triggers.sql --schema packages/shared/prisma/schema.prisma'",
    "db:pull": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db pull --schema=packages/shared/prisma/schema.prisma'",
    "db:pull:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db pull --schema=packages/shared/prisma/schema.prisma'",
    "db:pull:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db pull --schema=packages/shared/prisma/schema.prisma'",
    "db:studio": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma studio --schema=packages/shared/prisma/schema.prisma'",
    "db:studio:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma studio --schema=packages/shared/prisma/schema.prisma'",
    "db:studio:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma studio --schema=packages/shared/prisma/schema.prisma'",
    "db:seed": "./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db seed --schema=packages/shared/prisma/schema.prisma'",
    "db:seed:doppler": "USE_DOPPLER=true ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db seed --schema=packages/shared/prisma/schema.prisma'",
    "db:seed:local": "USE_DOPPLER=false ./scripts/run-with-env.sh bash -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST_URL}:${DATABASE_SERVICE_PORT}/${DATABASE_NAME}?schema=public}\" && prisma db seed --schema=packages/shared/prisma/schema.prisma'",
    "db:setup": "npm run db:push && npm run db:triggers && npm run db:seed",
    "db:setup:doppler": "npm run db:push:doppler && npm run db:triggers:doppler && npm run db:seed:doppler",
    "db:setup:local": "npm run db:push:local && npm run db:triggers:local && npm run db:seed:local",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.9.0",
    "@prisma/client": "5.22.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "eslint-config-next": "15.5.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^15.9.0",
    "knip": "^5.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "5.22.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.2.0"
  },
  "workspaces": [
    "packages/*",
    "server",
    "worker",
    "llm",
    "web"
  ],
  "prisma": {
    "seed": "node packages/shared/prisma/seed.js"
  }
}
