{
  "name": "weave-engine",
  "version": "1.0.0",
  "description": "AI engine service for Weave Notes",
  "license": "ISC",
  "author": {
    "name": "Gael Renê Gomes",
    "email": "hello@gaelgomes.dev",
    "url": "https://gaelgomes.dev"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon",
    "dev:doppler": "doppler run --project weave-engine --config dev -- npm run dev",
    "start:doppler": "doppler run --project weave-engine --config dev -- npm start",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "check": "npm run lint",
    "build": "npm run lint && npm run format:check",
    "test": "jest"
  },
  "keywords": [
    "ai",
    "weave-notes",
    "weave-engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugaelgomes/weave-notes.git"
  },
  "dependencies": {
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "axios": "^1.15.2",
    "dotenv": "^16.6.1",
    "ioredis": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "sentry": "^0.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
