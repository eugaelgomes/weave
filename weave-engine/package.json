{
  "name": "weave-engine",
  "version": "1.0.0",
  "description": "AI engine service for Weave Notes",
  "license": "ISC",
  "author": {
    "name": "Gael Renê Gomes",
    "email": "hello@gaelgomes.dev",
    "url": "https://gaelgomes.dev"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "dev:doppler": "doppler run --project theweave --config dev -- npm run dev",
    "start:doppler": "doppler run --project theweave --config dev -- npm start",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "tsc && npm run lint && npm run format:check",
    "test": "jest"
  },
  "keywords": [
    "ai",
    "weave-notes",
    "weave-engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugaelgomes/weave-notes.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "axios": "^1.15.2",
    "dotenv": "^16.6.1",
    "eventsource": "^4.1.0",
    "ioredis": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "pdf-parse": "^2.4.5",
    "sentry": "^0.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
}