# syntax=docker/dockerfile:1
#
# Lighter / faster builds: `.dockerignore` + BuildKit npm cache (Docker 23+).

FROM node:24-alpine

WORKDIR /app

RUN apk add --no-cache ca-certificates curl gnupg \
  && curl -fsSL --tlsv1.2 --proto '=https' --retry 3 https://cli.doppler.com/install.sh | sh \
  && apk del curl gnupg \
  && rm -rf /var/cache/apk/*

ENV DOPPLER_CONFIG_DIR=/tmp/.doppler

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

COPY package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY . .

# Let docker-entrypoint.sh run `npm ci` on start when bind-mount hides or stalemates node_modules.
ENV WEAVE_APP_AUTO_DEPS=1

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV DOPPLER_CONFIG=dev

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["doppler", "run", "--project", "weave-app", "--config", "dev", "--", "npm", "start"]
